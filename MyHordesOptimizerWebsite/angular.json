{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "MyHordesOptimizerWebsite": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "mho",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "sourceMap": true,
            "preserveSymlinks": true,
            "outputPath": {
              "base": "dist/MyHordesOptimizerWebsite"
            },
            "index": "src/index.html",
            "polyfills": [
              "@angular/localize/init"
            ],
            "tsConfig": "tsconfig.app.json",
            "webWorkerTsConfig": "tsconfig.worker.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/material-symbols/rounded.css",
              "node_modules/@fontsource/nunito/600.css",
              "node_modules/@fontsource/nunito/700.css",
              "node_modules/highlight.js/styles/atom-one-dark.min.css",
              "src/styles.scss",
              "public/scss/material-theme/theming.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "node_modules",
                "public/scss",
                "public/scss/material-theme",
                "public/scss/noel",
                "public/scss/halloween"
              ]
            },
            "scripts": [],
            "browser": "src/main.ts"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "15kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "test": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true,
              "polyfills": [
                "@angular/localize/init",
                "zone.js",
                "zone.js/testing",
                "zone.js/plugins/vitest-patch"
              ]
            },
            "staging": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "5mb",
                  "maximumError": "10mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kb",
                  "maximumError": "15kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.dev.ts"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "proxyConfig": "src/proxy.conf.json"
          },
          "configurations": {
            "production": {
              "buildTarget": "MyHordesOptimizerWebsite:build:production"
            },
            "development": {
              "buildTarget": "MyHordesOptimizerWebsite:build:development"
            },
            "staging": {
              "buildTarget": "MyHordesOptimizerWebsite:build:staging"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "ng-extract-i18n-merge:ng-extract-i18n-merge",
          "options": {
            "buildTarget": "MyHordesOptimizerWebsite:build",
            "format": "xlf",
            "outputPath": ".",
            "sourceFile": "src/i18n/messages.xlf",
            "targetFiles": [
              "public/i18n/xlf-files/messages.de.xlf",
              "public/i18n/xlf-files/messages.en.xlf",
              "public/i18n/xlf-files/messages.es.xlf"
            ]
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "runner": "vitest",
            "buildTarget": "::test",
            "tsConfig": "tsconfig.spec.json"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "src/**/*.ts",
              "src/**/*.html"
            ]
          }
        }
      },
      "i18n": {
        "sourceLocale": "fr",
        "locales": {
          "de": "public/i18n/xlf-files/messages.de.xlf",
          "en": "public/i18n/xlf-files/messages.en.xlf",
          "es": "public/i18n/xlf-files/messages.es.xlf"
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": [
      "angular-eslint"
    ]
  }
}
