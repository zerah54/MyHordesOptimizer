{
  "name": "my-hordes-optimizer-website",
  "version": "0.0.0",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.12.1"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run sentry:sourcemaps",
    "build:staging": "ng build --configuration staging",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test",
    "lint": "ng lint",
    "extract-i18n": "ng extract-i18n MyHordesOptimizerWebsite",
    "build-deploy": "ng build && firebase use prod && firebase deploy --only hosting:prod",
    "build-deploy:dev": "ng build --configuration staging && firebase use dev && firebase deploy --only hosting:dev",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org myhordes-optimizer --project frontend ./dist && sentry-cli sourcemaps upload --org myhordes-optimizer --project frontend ./dist"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.1.7",
    "@angular/common": "22.1.7",
    "@angular/compiler": "22.1.7",
    "@angular/core": "22.1.7",
    "@angular/forms": "22.1.7",
    "@angular/localize": "22.1.7",
    "@angular/material": "22.1.7",
    "@angular/material-moment-adapter": "22.1.7",
    "@angular/platform-browser": "22.1.7",
    "@angular/router": "22.1.7",
    "@egjs/hammerjs": "^2.0.17",
    "@microsoft/signalr": "^10.0.11",
    "@sentry/angular": "10.75.0",
    "@sentry/cli": "^3.8.0",
    "@tiptap/core": "^3.30.0",
    "@tiptap/extension-heading": "^3.30.0",
    "@tiptap/extension-highlight": "^3.30.0",
    "@tiptap/extension-image": "^3.30.0",
    "@tiptap/extension-table": "^3.30.0",
    "@tiptap/extension-task-item": "^3.30.0",
    "@tiptap/extension-task-list": "^3.30.0",
    "@tiptap/extension-text-align": "^3.30.0",
    "@tiptap/extension-text-style": "^3.30.0",
    "@tiptap/extensions": "^3.30.0",
    "@tiptap/starter-kit": "^3.30.0",
    "chart.js": "^4.5.1",
    "chartjs-plugin-datalabels": "2.2.0",
    "compass-mixins": "0.12.12",
    "firebase": "^12.19.0",
    "highlight.js": "^11.12.0",
    "keycharm": "^0.4.0",
    "material-symbols": "^0.47.4",
    "moment": "^2.31.0",
    "moment-timezone": "^0.6.4",
    "rxjs": "7.8.2",
    "vis-data": "^8.0.5",
    "vis-network": "^10.1.2",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular-eslint/eslint-plugin": "^22.5.0",
    "@angular-eslint/eslint-plugin-template": "^22.5.0",
    "@angular/build": "22.1.8",
    "@angular/cli": "22.1.8",
    "@angular/compiler-cli": "22.1.7",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@types/chart.js": "2.9.41",
    "@types/node": "^26.6.1",
    "@typescript-eslint/parser": "^8.70.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.10.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jsdom": "^30.1.0",
    "ng-extract-i18n-merge": "^3.1.0",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vis-util": "^6.0.2",
    "vitest": "^4.1.11",
    "vitest-canvas-mock": "^1.2.0",
    "xliff": "^6.4.0",
    "xlsx": "0.18.5"
  },
  "overrides": {
    "undici": "6.19.2",
    "undici-types": "6.19.2",
    "uuid": "11.1.0"
  }
}
