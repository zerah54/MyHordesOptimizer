      LEFT JOIN (&#xD;
          SELECT `p`.`name`, `i0`.`idItem`, `i0`.`propertyName`&#xD;
          FROM `ItemProperty` AS `i0`&#xD;
          INNER JOIN `Property` AS `p` ON `i0`.`propertyName` = `p`.`name`&#xD;
