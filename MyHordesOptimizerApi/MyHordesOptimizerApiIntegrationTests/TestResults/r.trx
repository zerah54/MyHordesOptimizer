          LEFT JOIN `LastUpdateInfo` AS `l0` ON `c`.`idLastUpdateInfo` = `l0`.`idLastUpdateInfo`&#xD;
          LEFT JOIN `Users` AS `u0` ON `l0`.`idUser` = `u0`.`idUser`&#xD;
          INNER JOIN `LastUpdateInfo` AS `l1` ON `t`.`idLastUpdateInfo` = `l1`.`idLastUpdateInfo`&#xD;
          LEFT JOIN `Users` AS `u1` ON `l1`.`idUser` = `u1`.`idUser`&#xD;
          LEFT JOIN `LastUpdateInfo` AS `l2` ON `t`.`idLastUpdateInfoGhoulStatus` = `l2`.`idLastUpdateInfo`&#xD;
