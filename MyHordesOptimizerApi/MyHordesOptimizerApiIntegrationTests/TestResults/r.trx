      LEFT JOIN (&#xD;
          SELECT `b0`.`idBag`, `b0`.`idItem`, `b0`.`isBroken`, `b0`.`count`, `i`.`idItem` AS `idItem0`, `i`.`deco`, `i`.`description_de`, `i`.`description_en`, `i`.`description_es`, `i`.`description_fr`, `i`.`dropRate_notPraf`, `i`.`dropRate_praf`, `i`.`guard`, `i`.`idCategory`, `i`.`img`, `i`.`img_broken`, `i`.`isHeaver`, `i`.`isObsolete`, `i`.`label_de`, `i`.`label_en`, `i`.`label_es`, `i`.`label_fr`, `i`.`mhId`, `i`.`uid`, `t3`.`idItem` AS `idItem1`, `t3`.`propertyName`, `t3`.`name`&#xD;
