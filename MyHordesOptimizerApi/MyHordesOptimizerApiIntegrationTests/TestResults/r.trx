      INSERT INTO `Town` (`idTown`, `day`, `hasExternalApi`, `height`, `idCata`, `idGuide`, `idShaman`, `idUserWishListUpdater`, `isChaos`, `isDevasted`, `isDoorOpen`, `isFinished`, `language`, `mapId`, `name`, `phase`, `rankingImportedAt`, `score`, `season`, `townType`, `waterWell`, `width`, `wishlistDateUpdate`, `x`, `y`)&#xD;
      VALUES (@p0, @p1, @p2, @p3, @p4, @p5, @p6, @p7, @p8, @p9, @p10, @p11, @p12, @p13, @p14, @p15, @p16, @p17, @p18, @p19, @p20, @p21, @p22, @p23, @p24);&#xD;
info: Microsoft.EntityFrameworkCore.Database.Command[20101]&#xD;
      Executed DbCommand (18ms) [Parameters=[], CommandType='Text', CommandTimeout='30']&#xD;
                      SELECT idTown AS Value FROM (&#xD;
                          SELECT idTown,&#xD;
                                 CAST(ROW_NUMBER() OVER (ORDER BY idTown) AS SIGNED) AS rankById,&#xD;
                                 CAST(ROW_NUMBER() OVER (ORDER BY mapId, idTown) AS SIGNED) AS rankByMap&#xD;
                          FROM Town WHERE phase = 3 AND idTown &gt; 0 AND mapId IS NOT NULL&#xD;
                      ) ranked&#xD;
                      WHERE ABS(rankById - rankByMap) &gt; 20&#xD;
                      ORDER BY idTown&#xD;
