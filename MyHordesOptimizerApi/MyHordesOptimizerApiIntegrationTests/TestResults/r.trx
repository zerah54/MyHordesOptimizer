          FROM `TownCitizen` AS `t`&#xD;
          LEFT JOIN `Bag` AS `b` ON `t`.`idBag` = `b`.`idBag`&#xD;
          LEFT JOIN `LastUpdateInfo` AS `l` ON `b`.`idLastUpdateInfo` = `l`.`idLastUpdateInfo`&#xD;
