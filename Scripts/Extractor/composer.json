{
    "name": "myhordes-optimizer/extractor",
    "description": "Extraction des référentiels MyHordes depuis le code source du jeu",
    "type": "project",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-zip": "*",
        "adbario/php-dot-notation": "^3.3",
        "jdrieghe/array-helpers": "^0.2.0",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MyHordesOptimizer\\Extractor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MyHordesOptimizer\\Extractor\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
